# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-side only (NO VITE_ prefix — used in scripts and edge functions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email (server-side only)
RESEND_API_KEY=your_resend_api_key_here

# ── Mux Video ──────────────────────────────────────────────────────────────────
# Get these at: https://dashboard.mux.com → Settings → API Access Tokens
# Create a token with "Mux Video" read/write permissions.
#
# MUX_TOKEN_ID and MUX_TOKEN_SECRET are used ONLY by the Supabase Edge Function
# (supabase/functions/mux-upload/index.ts). Deploy them with:
#   supabase secrets set MUX_TOKEN_ID=your_token_id MUX_TOKEN_SECRET=your_token_secret
#
# They must NEVER appear in frontend code or be prefixed with VITE_.

MUX_TOKEN_ID=your_mux_token_id_here
MUX_TOKEN_SECRET=your_mux_token_secret_here
